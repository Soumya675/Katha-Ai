# Server Port & Runtime Environment
PORT=3000
NODE_ENV="production"

# GEMINI_API_KEY: Required for Gemini AI speech synthesis, ASR transcription, and LLM rewriting.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Relational Database & Vector Store (PostgreSQL + pgvector)
# Optional in development (in-memory fallback active). Recommended for production persistence.
DATABASE_URL="postgresql://katha_user:katha_secret@localhost:5432/katha_speech"

# Redis Cache & GPU Task Queue
# Optional in development (in-memory queue active). Recommended for production GPU workers.
REDIS_URL="redis://localhost:6379/0"
